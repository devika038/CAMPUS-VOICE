# ==========================================
# Campus Voice Environment Variables Example
# ==========================================
# Copy this file or set these environment variables in your environment.

# MySQL 8 Database Configuration
DB_URL=jdbc:mysql://localhost:3306/campus_voice?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_local_mysql_password_here

# JWT Security
# Provide a 256-bit or longer secret key for signing tokens
JWT_SECRET=4c616d707573566f6963655365637572654a77745365637265744b657932303236466f7243616d707573566f696365417070
JWT_EXPIRATION_MS=86400000

# Server Port
PORT=8080

# Narrow CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
